{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-previews.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'per-project installs happen in build-previews.mjs'",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.vercel.app"
        }
      ]
    }
  ]
}
